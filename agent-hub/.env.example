# AgentHub 环境配置示例
# 复制为 .env 后按需修改：cp .env.example .env
#
# 嵌套配置项使用双下划线分隔：AGENTHUB_SERVER__PORT 对应 settings 中的 server.port
# 未设置的项回退到内置默认值（见 crates/config/src/loader.rs）

# ---------------------------------------------------------------------------
# 运行环境
# ---------------------------------------------------------------------------
# development | staging | production
AGENTHUB_ENV=development
# 外部化配置文件路径（可选，支持 toml / yaml / json；文件缺失时忽略）
AGENTHUB_CONFIG_FILE=config/agenthub.toml

# ---------------------------------------------------------------------------
# 服务
# ---------------------------------------------------------------------------
AGENTHUB_SERVER__HOST=0.0.0.0
AGENTHUB_SERVER__PORT=8080

# ---------------------------------------------------------------------------
# 日志 / 可观测性
# ---------------------------------------------------------------------------
RUST_LOG=agenthub=debug,tower_http=info,info
# pretty | json
AGENTHUB_OBSERVABILITY__LOG_FORMAT=pretty
AGENTHUB_OBSERVABILITY__METRICS_ENABLED=true
AGENTHUB_OBSERVABILITY__METRICS_PATH=/metrics
# OpenTelemetry OTLP gRPC 端点（留空则禁用导出）
AGENTHUB_OBSERVABILITY__OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# 认证
# ---------------------------------------------------------------------------
# 生产环境务必替换为高强度随机密钥（>= 32 字节）
AGENTHUB_AUTH__JWT_SECRET=change-me-to-a-random-32-byte-secret
AGENTHUB_AUTH__JWT_ISSUER=agenthub
AGENTHUB_AUTH__JWT_AUDIENCE=agenthub-clients
# 访问令牌有效期（秒）
AGENTHUB_AUTH__ACCESS_TOKEN_TTL_SECS=3600
# API Key 前缀
AGENTHUB_AUTH__API_KEY_PREFIX=ah_

# ---------------------------------------------------------------------------
# 存储
# ---------------------------------------------------------------------------
# memory | postgres
AGENTHUB_STORAGE__BACKEND=memory
AGENTHUB_STORAGE__DATABASE_URL=postgres://agenthub:agenthub@localhost:5432/agenthub
AGENTHUB_STORAGE__DATABASE_MAX_CONNECTIONS=10
AGENTHUB_STORAGE__REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# 注册中心（Agent 动态注册）
# ---------------------------------------------------------------------------
# Agent 注册租约 TTL（秒），超时未续约视为下线
AGENTHUB_REGISTRY__LEASE_TTL_SECS=60
# 过期 Agent 清理扫描间隔（秒）
AGENTHUB_REGISTRY__CLEANUP_INTERVAL_SECS=15

# ---------------------------------------------------------------------------
# 网关
# ---------------------------------------------------------------------------
AGENTHUB_GATEWAY__REQUEST_TIMEOUT_SECS=30
AGENTHUB_GATEWAY__CONNECT_TIMEOUT_SECS=5
AGENTHUB_GATEWAY__MAX_BODY_BYTES=4194304
AGENTHUB_GATEWAY__CORS_ALLOW_ORIGINS=*
